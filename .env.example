# Supabase público para Expo
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Google / Firebase API keys
EXPO_PUBLIC_GOOGLE_ANDROID_API_KEY=your_android_google_api_key
EXPO_PUBLIC_GOOGLE_IOS_API_KEY=your_ios_google_api_key

# Secretos privados de Supabase Edge Functions
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
RESEND_API_KEY=your_resend_api_key
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret
FRONTEND_BASE_URL=https://your-domain.example
